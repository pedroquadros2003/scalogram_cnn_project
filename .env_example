# Copy this file to '.env' and adjust the paths to your local environment.

# Path to the DROZY dataset directory
DROZY_DIR="/path/to/your/DataSets/DROZY/DROZY"

# Path to the ITA Pilot dataset directory
ITA_PILOT_DIR="/path/to/your/DataSets/ITA_PILOT"

# Path to the SEED-VIG Raw Data directory
SEED_VIG_DIR="/path/to/your/DataSets/SEED-VIG/Raw_Data"

# Path to the SEED-VIG PERCLOS Labels directory
SEED_VIG_LABELS="/path/to/your/DataSets/SEED-VIG/perclos_labels"
