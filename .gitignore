# ==============================================================================
# Python Environment and Cache
# ==============================================================================
# Ignore Python virtual environments and env file to avoid committing large external dependencies or local paths
venv
venv/
.env
.venv
.venv/
venv_wsl
venv_wsl/

# Ignore Python compiled bytecode to avoid commit noise and caching issues
__pycache__/

# Ignore Git directory itself (normally handled automatically, but kept for completeness)
.git

# Ignore package distribution and egg metadata generated during editable installs
*.egg-info/

# ==============================================================================
# Run Outputs
# ==============================================================================
# Ignore model training logs, metrics, figures, and saved models
# We keep only the directory itself via the .gitkeep file
outputs/*
!outputs/.gitkeep

# ==============================================================================
# Data and Scalograms
# ==============================================================================
# Ignore raw datasets, index files, and generated scalogram images (very heavy files)
# Keep only the small example dataset for testing purposes
data/*
!data/generated_scalograms_ALL_gray_overlap0.733_extra_input_example/
!data/generated_scalograms_ALL_gray_overlap0.733_extra_input_example/**

# ==============================================================================
# Configuration Files (Experiment & Generator Params)
# ==============================================================================
# Ignore custom hyperparameter search configurations created by users
# Keep only the generic search example yaml files
configs/hyperparameter_search/*
!configs/hyperparameter_search/cross_validation_loso_example.yaml
!configs/hyperparameter_search/gridsearch_example.yaml
!configs/hyperparameter_search/keras_search_example.yaml

# Ignore custom RNN hyperparameter search configurations created by users
# Keep only the generic search example yaml files
configs/hyperparameter_search_rnn/*
!configs/hyperparameter_search_rnn/forecast_gridsearch_example.yaml
!configs/hyperparameter_search_rnn/classifier_gridsearch_example.yaml
!configs/hyperparameter_search_rnn/drozy_forecast_gridsearch_example.yaml
!configs/hyperparameter_search_rnn/drozy_classifier_gridsearch_example.yaml

# Ignore custom scalogram generator yaml configurations created by users
# Keep only the baseline example configs for DROZY and SEED-VIG
configs/dataset_generation/*
!configs/dataset_generation/drozy_example.yaml
!configs/dataset_generation/drozy_simple_example.yaml
!configs/dataset_generation/seedvig_example.yaml
!configs/dataset_generation/seedvig_simple_example.yaml

# Ignore custom prediction parameters yaml configurations created by users
# Keep only the baseline example configs for SEED-VIG and DROZY
configs/model_training_rnn_classifier/*
!configs/model_training_rnn_classifier/seedvig_classify_example.yaml
!configs/model_training_rnn_classifier/drozy_classify_example.yaml
configs/model_training_rnn_predictor/*
!configs/model_training_rnn_predictor/seedvig_predict_example.yaml

# ==============================================================================
# Miscellaneous and Internal Utilities
# ==============================================================================
# Ignore ad-hoc helper scripts and extra documentation files
helpful_additionals/*

# Ignore local experimental/internal scripts folder
experiments/internal/